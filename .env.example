# Aspects Dashboard API
ASPECTS_API_URL=https://order.aspects.media
ASPECTS_API_KEY=your_api_key_here

# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack member IDs to @mention in the daily message (VA + editor)
SLACK_VA_ID=U0AQEU7HSKH
SLACK_EDITOR_ID=U0B4LFFNFLN

# Public URL of the deployed site (used to deep-link notes/images in Slack)
APP_URL=https://aspects-va-editing-notes-production.up.railway.app

# Schedule (cron expression, weekdays only by default)
SLACK_CRON=5 20 * * 1-5

# Server
PORT=3000
TZ=America/Los_Angeles
