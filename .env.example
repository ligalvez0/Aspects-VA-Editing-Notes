# Aspects Dashboard API
ASPECTS_API_URL=https://order.aspects.media
ASPECTS_API_KEY=your_api_key_here

# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Schedule (cron expression, weekdays only by default)
SLACK_CRON=5 20 * * 1-5

# Server
PORT=3000
TZ=America/Los_Angeles
